generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  products     Product[]
  bids         Bid[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String
  imageUrl    String?
  sellerId    String    @db.Uuid
  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  auction     Auction?
  createdAt   DateTime  @default(now())

  @@index([sellerId])
}

model Auction {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @unique @db.Uuid
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  startsAt     DateTime
  endsAt       DateTime
  startingPrice Decimal      @db.Decimal(12, 2)
  currentPrice  Decimal      @db.Decimal(12, 2)
  minIncrement  Decimal      @default(1) @db.Decimal(12, 2)
  status        AuctionStatus @default(SCHEDULED)
  bids          Bid[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([endsAt])
}

model Bid {
  id        String   @id @default(uuid()) @db.Uuid
  auctionId String   @db.Uuid
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidderId  String   @db.Uuid
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt(sort: Desc)])
  @@index([bidderId, createdAt(sort: Desc)])
}
